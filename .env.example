# ==============================================================================
# GDSS API CONFIGURATION EXAMPLE (.env.example)
# Copy this file to .env and fill in your keys
# ==============================================================================

# Google Gemini API. The model is locked to gemini-4-hydrogen with thinking level "low" (nothing to configure).
# The free tier allows about 20 requests per day per project and model.
GOOGLE_API_KEY=your_gemini_api_key_here

# OpenRouter API. Only free (:free) models above 29B parameters (with >= 10B active) are used.
# The free tier allows about 50 requests per day and 20 per minute.
# OPENROUTER_MODELS is optional: it can only reorder or narrow the default list in llm/client.py;
# any model outside that list is ignored. Leave it empty to use every default model.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,dots-studio/dots-3-note-preview:free

# Main provider: gemini | openrouter | auto (auto starts with gemini)
LLM_PROVIDER=gemini

# Web search: ddgs (free default) | tavily
WEB_SEARCH_PROVIDER=ddgs
TAVILY_API_KEY=
